# ========================================================
# Chronos - AI Personal Growth & Task Management System
# Production & Vercel Environment Configuration
# ========================================================

# --------------------------------------------------------
# 1. CORE AI CAPABILITIES (GOOGLE GEMINI - GOOGLE AI STUDIO)
# --------------------------------------------------------
# GEMINI_API_KEY: Required for official Google Gemini API calls (Goal decomposition, task atomization,
# daily circadian briefing, and interactive productivity coach).
# In Google AI Studio, injected automatically. On Vercel, generate an API key at https://aistudio.google.com/
# NEVER expose this key in frontend code or client bundles.
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# GEMINI_MODEL: Configurable Google Gemini model (default: gemini-3.8-flash).
# Options: "gemini-3.8-flash" (recommended general & structured output), "gemini-2.5-flash" (ultra-fast throughput)
GEMINI_MODEL="gemini-3.8-flash"

# --------------------------------------------------------
# 2. APPLICATION & HOSTING CONFIGURATION
# --------------------------------------------------------
# APP_URL: The public URL where this app is hosted (e.g., https://your-project.vercel.app).
# Used for CORS validation, OAuth callbacks, and calendar web links.
APP_URL="https://your-project.vercel.app"

# VITE_API_URL: Optional. Leave empty when deployed as a monorepo on Vercel (defaults to relative '/api').
# Only set this if hosting frontend on Vercel and backend separately (e.g. Render, Railway, Fly.io):
# VITE_API_URL="https://your-backend-api.onrender.com/api"

# PORT & ENVIRONMENT
PORT=3000
NODE_ENV="production"

# --------------------------------------------------------
# 3. AUTHENTICATION & SECURITY
# --------------------------------------------------------
# ENFORCE_AUTH: Set to "false" (default) for single-user / personal productivity deployment.
# Set to "true" if you require strict JWT Bearer token authentication on all /api endpoints.
ENFORCE_AUTH="false"

# USER_EMAIL: Default user profile owner email address
USER_EMAIL="user@chronos.ai"

# JWT_SECRET: Stable, randomly generated secret used for signing and verifying user session tokens (min 32 bytes).
JWT_SECRET="REPLACE_WITH_A_STABLE_RANDOM_SECRET_OF_AT_LEAST_32_BYTES"
JWT_EXPIRES_IN="7d"

# CORS SETTINGS
# Set to true if accessing API across different domains or during Vercel preview branch deployments
CORS_ALLOW_ALL="true"

# --------------------------------------------------------
# 4. GOOGLE ACCOUNT AUTHENTICATION & GOOGLE CLOUD OAUTH 2.0
# --------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Configure Authorized JavaScript origins (e.g., https://your-project.vercel.app and http://localhost:3000)
# and Authorized redirect URIs.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"
GOOGLE_REDIRECT_URI="https://your-project.vercel.app/api/calendar/callback"

# --------------------------------------------------------
# 5. DATABASE CONFIGURATION (CRITICAL FOR VERCEL SERVERLESS PERSISTENCE)
# --------------------------------------------------------
# Vercel serverless functions run in ephemeral, stateless containers where local /tmp files
# are reset on cold starts and redeployments.
# To guarantee persistent multi-tenant storage across all serverless invocations,
# provide a PostgreSQL database connection string (Supabase, Neon, AWS RDS, Cloud SQL):
# DATABASE_URL="postgresql://user:password@db-host:5432/chronos?sslmode=require"
# DATABASE_URL is mandatory for production and serverless deployments. The runtime uses
# Prisma relational tables, not the legacy JSONB root. Apply prisma migrate deploy and
# import a verified legacy snapshot before switching an existing installation.
# Local JSON storage is available only in non-production development.
# Use a pooled URL for serverless runtime traffic and a direct URL for migrations
# if your provider recommends separate connection strings.


# CHRONOS_DATA_ENCRYPTION_KEY: stable 32-byte base64 (or 64-char hex) key used to encrypt
# LegacySnapshot archives and Google OAuth tokens. Generate once, store in a secrets manager,
# and back it up separately. Losing it makes encrypted archives/tokens unrecoverable.
# CHRONOS_DATA_ENCRYPTION_KEY=

# Safety switch: only set true to initialize a genuinely new, empty relational database.
# Never set this when legacy data exists; export, migrate and import the verified snapshot first.
# CHRONOS_ALLOW_EMPTY_DB_INIT=true

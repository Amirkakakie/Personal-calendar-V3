// ============================================================================
// Chronos OS - Production Prisma Database Schema
// Enterprise Personal Growth, Work & Study Operating System
// Compatible with PostgreSQL & SQLite
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum LifeDomainType {
  WORK_CAREER
  ACADEMIC_STUDY
  PERSONAL_GROWTH
  HEALTH_HABITS
}

enum PriorityLevel {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum EisenhowerQuadrant {
  Q1_URGENT_IMPORTANT       // Do First (Crises & Critical Milestones)
  Q2_NOT_URGENT_IMPORTANT   // Schedule (Strategic Deep Work & Skill Mastery)
  Q3_URGENT_NOT_IMPORTANT   // Delegate / Batch (Administrative Traps)
  Q4_NEITHER                // Eliminate / Review (Low Leverage)
}

enum BiologicalEnergyLevel {
  HIGH_FOCUS    // Deep cognitive capacity, mathematical/coding/architectural tasks (Peak Morning 08:30-12:30)
  CREATIVE      // Brainstorming, design, writing, problem structuring (Mid-Afternoon 14:00-16:30)
  LOW_ADMIN     // Email, filing, reviews, routine operations (Late Afternoon 16:30-18:30)
}

enum Timeframe {
  YEARLY
  QUARTERLY
  MONTHLY
}

enum SkillTier {
  NOVICE
  APPRENTICE
  PRACTITIONER
  EXPERT
  MASTER
}

// ----------------------------------------------------------------------------
// USER & CORE SYSTEM
// ----------------------------------------------------------------------------

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String
  avatarUrl        String?
  avatarColor      String       @default("from-violet-600 to-indigo-600")
  initials         String       @default("")
  title            String       @default("")
  role             String       @default("user")
  joinedAt         DateTime     @default(now())
  
  // RPG Progression
  totalXp          Int          @default(0)
  level            Int          @default(1)
  rpgTitle         String       @default("Aspiring Strategist")
  streakDays       Int          @default(1)
  bestStreakDays   Int          @default(1)
  focusScore       Int          @default(85) // 0 - 100
  
  // Google OAuth Tokens (Encrypted in production)
  googleId         String?      @unique
  googleAccessToken String?
  googleRefreshToken String?
  googleTokenExpiry DateTime?
  googleCalendarId String?      @default("primary")
  
  passwordHash     String?
  
  // Relationships
  domains          Domain[]
  goals            GoalOKR[]
  projects         Project[]
  tasks            Task[]
  timeLogs         TimeLog[]
  skills           UserSkill[]
  badges           UserBadge[]
  calendarEvents   CalendarEvent[]
  workspaceMembers WorkspaceMember[]
  ownedProjects    TeamProject[]
  sentInvites      ProjectInvitation[] @relation("SentInvites")
  receivedInvites  ProjectInvitation[] @relation("ReceivedInvites")
  ownedWorkspaces  Workspace[] @relation("WorkspaceOwner")
  assignedTeamTasks TeamTask[] @relation("TeamTaskAssignee")
  authSessions     AuthSession[]
  projectMemberships ProjectMember[]
  snapshots        LegacySnapshot[]
  authoredTeamTaskComments TeamTaskComment[] @relation("TeamTaskCommentAuthor")
  stats              UserStats?
  googleConnection   GoogleConnection?
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([email])
  legacyData Json?

}

// ----------------------------------------------------------------------------
// LIFE DOMAINS & OKRS
// ----------------------------------------------------------------------------

model Domain {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LifeDomainType
  name        String
  description String?
  colorHex    String         @default("#3B82F6")
  icon        String         @default("Target")
  weightPct   Int            @default(25) // Desired focus distribution %
  
  goals       GoalOKR[]
  projects    Project[]
  tasks       Task[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, type])
  @@index([userId])
  legacyData Json?

}

model GoalOKR {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId        String?
  domain          Domain?        @relation(fields: [domainId], references: [id], onDelete: SetNull)
  category        LifeDomainType @default(WORK_CAREER)
  
  title           String
  description     String?
  timeframe       Timeframe      @default(QUARTERLY)
  targetDate      DateTime
  progressPercent Int            @default(0)
  
  keyResults      KeyResult[]
  projects        Project[]
  tasks           Task[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, timeframe])
  @@index([domainId])
  legacyData Json?

}

model KeyResult {
  id           String    @id @default(uuid())
  goalId       String
  goal         GoalOKR   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title        String
  currentValue Float     @default(0)
  targetValue  Float     @default(100)
  unit         String    @default("%")
  completed    Boolean   @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([goalId])
}

// ----------------------------------------------------------------------------
// PROJECTS & TASKS
// ----------------------------------------------------------------------------

model Project {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId        String?
  domain          Domain?        @relation(fields: [domainId], references: [id], onDelete: SetNull)
  goalId          String?
  goal            GoalOKR?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  
  name            String
  description     String?
  color           String         @default("blue")
  status          TaskStatus     @default(IN_PROGRESS)
  targetHours     Float          @default(20.0)
  loggedHours     Float          @default(0.0)
  hourlyValuation Float          @default(85.0) // Value generation per hour ($ or cognitive index)
  driveFolderUrl  String?
  
  tasks           Task[]
  timeLogs        TimeLog[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@index([domainId])
  @@index([goalId])
  legacyData Json?

}

model Task {
  id                    String                @id @default(uuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId              String?
  domain                Domain?               @relation(fields: [domainId], references: [id], onDelete: SetNull)
  goalId                String?
  goal                  GoalOKR?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId             String?
  project               Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  title                 String
  description           String?
  category              LifeDomainType        @default(WORK_CAREER)
  priority              PriorityLevel         @default(MEDIUM)
  status                TaskStatus            @default(TODO)
  eisenhower            EisenhowerQuadrant    @default(Q2_NOT_URGENT_IMPORTANT)
  energyLevel           BiologicalEnergyLevel @default(HIGH_FOCUS)
  
  // Scheduling & Google Calendar Sync
  dueDate               String?               // YYYY-MM-DD
  dueTime               String?               // HH:mm
  durationMinutes       Int                   @default(45)
  googleCalendarEventId String?
  googleTasksId         String?
  syncedToGoogle        Boolean               @default(false)
  calendarOverlay       String                @default("work") // "work" | "study" | "personal"
  
  // Gamification & Skill Attachment
  xpReward              Int                   @default(50)
  linkedSkillId         String?
  linkedSkill           Skill?                @relation(fields: [linkedSkillId], references: [id], onDelete: SetNull)
  
  // Google Docs Workspace Resource Link
  driveDocUrl           String?
  
  subtasks              SubTask[]
  timeLogs              TimeLog[]
  calendarEvents        CalendarEvent[]
  tags                  String[]              @default([])
  
  completedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([userId, status])
  @@index([dueDate, dueTime])
  @@index([projectId])
  @@index([goalId])
  @@index([domainId])
  @@index([linkedSkillId])
  legacyData Json?

}

model SubTask {
  id               String   @id @default(uuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title            String
  completed        Boolean  @default(false)
  estimatedMinutes Int      @default(20)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([taskId])
}

// ----------------------------------------------------------------------------
// TIME-TRACKING, STOPWATCH & TIME ROI
// ----------------------------------------------------------------------------

model TimeLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  durationSeconds Int
  hourlyRate      Float    @default(75.0)
  calculatedRoi   Float    // (durationSeconds / 3600) * hourlyRate
  efficiencyRate  Int      @default(90) // % productivity score for this session
  energyReported  String   @default("High")
  note            String?
  
  startedAt       DateTime
  endedAt         DateTime @default(now())

  @@index([userId, startedAt])
  @@index([taskId])
  @@index([projectId])
  legacyData Json?

}

// ----------------------------------------------------------------------------
// RPG SKILL TREE & GAMIFICATION
// ----------------------------------------------------------------------------

model Skill {
  id          String      @id @default(uuid())
  name        String
  category    String      // e.g. "Distributed Systems", "AI & ML", "Systems Design", "Biohacking"
  tier        SkillTier   @default(NOVICE)
  icon        String      @default("Zap")
  description String
  parentSkillId String?
  parentSkill   Skill?    @relation("SkillHierarchy", fields: [parentSkillId], references: [id], onDelete: SetNull)
  childSkills   Skill[]   @relation("SkillHierarchy")
  
  requiredXp  Int         @default(500)
  tasks       Task[]
  userSkills  UserSkill[]

  createdAt   DateTime    @default(now())

  @@index([name])
  @@index([parentSkillId])
  legacyData Json?

}

model UserSkill {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  currentXp   Int      @default(0)
  level       Int      @default(1)
  masteryPct  Int      @default(10)
  isUnlocked  Boolean  @default(true)
  
  unlockedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
  legacyData Json?

}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  name        String
  description String
  icon        String
  category    String
  xpBonus     Int      @default(100)
  unlockedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
  legacyData Json?

}

// ----------------------------------------------------------------------------
// CALENDAR EVENTS & SYNC
// ----------------------------------------------------------------------------

model CalendarEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  category      String   @default("work")
  calendarType  String   @default("work") // "work" | "study" | "personal"
  isGoogleEvent Boolean  @default(false)
  googleEventId String?
  htmlLink      String?
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, startTime])
  @@index([taskId])
  @@index([googleEventId])
  legacyData Json?

}

// ----------------------------------------------------------------------------
// WORKSPACES & TEAM COLLABORATION
// ----------------------------------------------------------------------------

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceType {
  PERSONAL
  TEAM
}

model Workspace {
  id          String            @id @default(uuid())
  name        String
  slug        String            @unique
  type        WorkspaceType     @default(TEAM)
  ownerId     String
  isPersonal  Boolean           @default(false)
  owner       User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  members     WorkspaceMember[]
  projects    TeamProject[]

  @@index([ownerId])
  @@index([ownerId, isPersonal])
  legacyData Json?

}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model TeamProject {
  id          String        @id @default(uuid())
  workspaceId String
  ownerId     String
  ownerEmail  String
  name        String
  key         String
  description String?
  color       String        @default("#6366f1")
  icon        String        @default("ShieldCheck")
  targetDate  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner       User          @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  tasks       TeamTask[]
  invitations ProjectInvitation[]
  members     ProjectMember[]
  tags        TeamTaskTag[]

  @@index([workspaceId])
  @@index([ownerId])
  legacyData Json?

}

model TeamTask {
  id             String      @id @default(uuid())
  projectId      String
  taskNumber     Int
  columnId       String      @default("todo")
  title          String
  description    String?
  priority       String      @default("medium")
  assigneeId     String?
  assignee       User?       @relation("TeamTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  dueDate        String?
  estimatedHours Float       @default(0)
  // Legacy JSON columns are retained during the staged data migration.
  // New writes must use normalized child relations after the repository cutover.
  subtasksJson   Json?
  tagsJson       Json?
  commentsJson   Json?
  subtasks       TeamTaskSubtask[]
  comments       TeamTaskComment[]
  tagAssignments TeamTaskTagAssignment[]
  order          Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  project        TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@unique([projectId, taskNumber])
  @@index([projectId, columnId, order])
  @@index([assigneeId])
  legacyData Json?

}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      WorkspaceRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project   TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId, role])
}

model TeamTaskSubtask {
  id          String   @id @default(uuid())
  taskId      String
  title       String
  completed   Boolean  @default(false)
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, position])
}

model TeamTaskComment {
  id          String   @id @default(uuid())
  taskId      String
  authorId    String
  author      User     @relation("TeamTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  body        String
  authorName String @default("")
  authorInitials String @default("")
  authorColor String @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  task        TeamTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([authorId])
  legacyData Json?

}

model TeamTaskTag {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  createdAt   DateTime @default(now())
  project     TeamProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments TeamTaskTagAssignment[]

  @@unique([projectId, name])
  @@index([projectId])
}

model TeamTaskTagAssignment {
  id        String       @id @default(uuid())
  taskId    String
  tagId     String
  task      TeamTask     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag       TeamTaskTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([taskId, tagId])
  @@index([tagId])
}

model UserStats {
  id                 String   @id @default(uuid())
  userId             String   @unique
  focusMinutes       Int      @default(0)
  pomodoroSessions   Int      @default(0)
  totalXp            Int      @default(0)
  userLevel          Int      @default(1)
  rpgTitle           String   @default("Novice Pioneer")
  focusScore         Int      @default(100)
  totalRoiDollars    Float    @default(0)
  activityHistory    Json     @default("{}")
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleConnection {
  id                 String   @id @default(uuid())
  userId             String   @unique
  googleId           String?  @unique
  email              String   @default("")
  accessToken        String?
  refreshToken       String?
  tokenExpiry        DateTime?
  calendarId         String   @default("primary")
  isConnected        Boolean  @default(false)
  updatedAt          DateTime @updatedAt

  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LegacySnapshot {
  id             String   @id
  userId         String?
  sourceVersion  String
  payload        Json
  checksum       String
  importedAt     DateTime @default(now())
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, importedAt])
}

model DatabaseRevision {
  id        String   @id
  version   BigInt   @default(1)
  updatedAt DateTime @updatedAt
}

model AuthSession {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model ProjectInvitation {
  id              String        @id @default(uuid())
  projectId       String
  invitedEmail    String
  recipientId     String?
  invitedByUserId String
  projectName     String        @default("")
  projectKey      String        @default("")
  projectColor    String        @default("#6366f1")
  invitedByName   String        @default("")
  invitedByEmail  String        @default("")
  role            WorkspaceRole @default(MEMBER)
  status          String        @default("PENDING") // PENDING, ACCEPTED, DECLINED
  createdAt       DateTime      @default(now())

  project         TeamProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy       User          @relation("SentInvites", fields: [invitedByUserId], references: [id], onDelete: Cascade)
  recipient       User?         @relation("ReceivedInvites", fields: [recipientId], references: [id], onDelete: SetNull)

  @@index([invitedEmail])
  @@index([projectId])
  legacyData Json?

}

// ============================================================================
// Chronos OS - Production Prisma Database Schema
// Enterprise Personal Growth, Work & Study Operating System
// Compatible with PostgreSQL & SQLite
// ============================================================================

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------------------------------
// ENUMS
// ----------------------------------------------------------------------------

enum LifeDomainType {
  WORK_CAREER
  ACADEMIC_STUDY
  PERSONAL_GROWTH
  HEALTH_HABITS
}

enum PriorityLevel {
  HIGH
  MEDIUM
  LOW
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  ARCHIVED
}

enum EisenhowerQuadrant {
  Q1_URGENT_IMPORTANT       // Do First (Crises & Critical Milestones)
  Q2_NOT_URGENT_IMPORTANT   // Schedule (Strategic Deep Work & Skill Mastery)
  Q3_URGENT_NOT_IMPORTANT   // Delegate / Batch (Administrative Traps)
  Q4_NEITHER                // Eliminate / Review (Low Leverage)
}

enum BiologicalEnergyLevel {
  HIGH_FOCUS    // Deep cognitive capacity, mathematical/coding/architectural tasks (Peak Morning 08:30-12:30)
  CREATIVE      // Brainstorming, design, writing, problem structuring (Mid-Afternoon 14:00-16:30)
  LOW_ADMIN     // Email, filing, reviews, routine operations (Late Afternoon 16:30-18:30)
}

enum Timeframe {
  YEARLY
  QUARTERLY
  MONTHLY
}

enum SkillTier {
  NOVICE
  APPRENTICE
  PRACTITIONER
  EXPERT
  MASTER
}

// ----------------------------------------------------------------------------
// USER & CORE SYSTEM
// ----------------------------------------------------------------------------

model User {
  id               String       @id @default(uuid())
  email            String       @unique
  name             String
  avatarUrl        String?
  role             String       @default("user")
  
  // RPG Progression
  totalXp          Int          @default(0)
  level            Int          @default(1)
  rpgTitle         String       @default("Aspiring Strategist")
  streakDays       Int          @default(1)
  bestStreakDays   Int          @default(1)
  focusScore       Int          @default(85) // 0 - 100
  
  // Google OAuth Tokens (Encrypted in production)
  googleId         String?      @unique
  googleAccessToken String?
  googleRefreshToken String?
  googleTokenExpiry DateTime?
  googleCalendarId String?      @default("primary")
  
  // Relationships
  domains          Domain[]
  goals            GoalOKR[]
  projects         Project[]
  tasks            Task[]
  timeLogs         TimeLog[]
  skills           UserSkill[]
  badges           UserBadge[]
  calendarEvents   CalendarEvent[]
  
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([email])
}

// ----------------------------------------------------------------------------
// LIFE DOMAINS & OKRS
// ----------------------------------------------------------------------------

model Domain {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        LifeDomainType
  name        String
  description String?
  colorHex    String         @default("#3B82F6")
  icon        String         @default("Target")
  weightPct   Int            @default(25) // Desired focus distribution %
  
  goals       GoalOKR[]
  projects    Project[]
  tasks       Task[]

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([userId, type])
  @@index([userId])
}

model GoalOKR {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId        String?
  domain          Domain?        @relation(fields: [domainId], references: [id], onDelete: SetNull)
  category        LifeDomainType @default(WORK_CAREER)
  
  title           String
  description     String?
  timeframe       Timeframe      @default(QUARTERLY)
  targetDate      DateTime
  progressPercent Int            @default(0)
  
  keyResults      KeyResult[]
  projects        Project[]
  tasks           Task[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, timeframe])
  @@index([domainId])
}

model KeyResult {
  id           String    @id @default(uuid())
  goalId       String
  goal         GoalOKR   @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title        String
  currentValue Float     @default(0)
  targetValue  Float     @default(100)
  unit         String    @default("%")
  completed    Boolean   @default(false)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([goalId])
}

// ----------------------------------------------------------------------------
// PROJECTS & TASKS
// ----------------------------------------------------------------------------

model Project {
  id              String         @id @default(uuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId        String?
  domain          Domain?        @relation(fields: [domainId], references: [id], onDelete: SetNull)
  goalId          String?
  goal            GoalOKR?       @relation(fields: [goalId], references: [id], onDelete: SetNull)
  
  name            String
  description     String?
  color           String         @default("blue")
  status          TaskStatus     @default(IN_PROGRESS)
  targetHours     Float          @default(20.0)
  loggedHours     Float          @default(0.0)
  hourlyValuation Float          @default(85.0) // Value generation per hour ($ or cognitive index)
  driveFolderUrl  String?
  
  tasks           Task[]
  timeLogs        TimeLog[]

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId, status])
  @@index([domainId])
  @@index([goalId])
}

model Task {
  id                    String                @id @default(uuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  domainId              String?
  domain                Domain?               @relation(fields: [domainId], references: [id], onDelete: SetNull)
  goalId                String?
  goal                  GoalOKR?              @relation(fields: [goalId], references: [id], onDelete: SetNull)
  projectId             String?
  project               Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  title                 String
  description           String?
  category              LifeDomainType        @default(WORK_CAREER)
  priority              PriorityLevel         @default(MEDIUM)
  status                TaskStatus            @default(TODO)
  eisenhower            EisenhowerQuadrant    @default(Q2_NOT_URGENT_IMPORTANT)
  energyLevel           BiologicalEnergyLevel @default(HIGH_FOCUS)
  
  // Scheduling & Google Calendar Sync
  dueDate               String?               // YYYY-MM-DD
  dueTime               String?               // HH:mm
  durationMinutes       Int                   @default(45)
  googleCalendarEventId String?
  googleTasksId         String?
  syncedToGoogle        Boolean               @default(false)
  calendarOverlay       String                @default("work") // "work" | "study" | "personal"
  
  // Gamification & Skill Attachment
  xpReward              Int                   @default(50)
  linkedSkillId         String?
  linkedSkill           Skill?                @relation(fields: [linkedSkillId], references: [id], onDelete: SetNull)
  
  // Google Docs Workspace Resource Link
  driveDocUrl           String?
  
  subtasks              SubTask[]
  timeLogs              TimeLog[]
  calendarEvents        CalendarEvent[]
  tags                  String[]              @default([])
  
  completedAt           DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([userId, status])
  @@index([dueDate, dueTime])
  @@index([projectId])
  @@index([goalId])
  @@index([domainId])
  @@index([linkedSkillId])
}

model SubTask {
  id               String   @id @default(uuid())
  taskId           String
  task             Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title            String
  completed        Boolean  @default(false)
  estimatedMinutes Int      @default(20)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([taskId])
}

// ----------------------------------------------------------------------------
// TIME-TRACKING, STOPWATCH & TIME ROI
// ----------------------------------------------------------------------------

model TimeLog {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  task            Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  
  durationSeconds Int
  hourlyRate      Float    @default(75.0)
  calculatedRoi   Float    // (durationSeconds / 3600) * hourlyRate
  efficiencyRate  Int      @default(90) // % productivity score for this session
  energyReported  String   @default("High")
  note            String?
  
  startedAt       DateTime
  endedAt         DateTime @default(now())

  @@index([userId, startedAt])
  @@index([taskId])
  @@index([projectId])
}

// ----------------------------------------------------------------------------
// RPG SKILL TREE & GAMIFICATION
// ----------------------------------------------------------------------------

model Skill {
  id          String      @id @default(uuid())
  name        String      @unique
  category    String      // e.g. "Distributed Systems", "AI & ML", "Systems Design", "Biohacking"
  tier        SkillTier   @default(NOVICE)
  icon        String      @default("Zap")
  description String
  parentSkillId String?
  parentSkill   Skill?    @relation("SkillHierarchy", fields: [parentSkillId], references: [id], onDelete: SetNull)
  childSkills   Skill[]   @relation("SkillHierarchy")
  
  requiredXp  Int         @default(500)
  tasks       Task[]
  userSkills  UserSkill[]

  createdAt   DateTime    @default(now())

  @@index([parentSkillId])
}

model UserSkill {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  
  currentXp   Int      @default(0)
  level       Int      @default(1)
  masteryPct  Int      @default(10)
  isUnlocked  Boolean  @default(true)
  
  unlockedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, skillId])
  @@index([userId])
  @@index([skillId])
}

model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId     String
  name        String
  description String
  icon        String
  category    String
  xpBonus     Int      @default(100)
  unlockedAt  DateTime @default(now())

  @@unique([userId, badgeId])
  @@index([userId])
}

// ----------------------------------------------------------------------------
// CALENDAR EVENTS & SYNC
// ----------------------------------------------------------------------------

model CalendarEvent {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  startTime     DateTime
  endTime       DateTime
  category      String   @default("work")
  calendarType  String   @default("work") // "work" | "study" | "personal"
  isGoogleEvent Boolean  @default(false)
  googleEventId String?
  htmlLink      String?
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, startTime])
  @@index([taskId])
  @@index([googleEventId])
}
